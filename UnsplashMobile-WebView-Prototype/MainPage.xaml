<Page
    x:Class="UnsplashMobile.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="PhotoCardTemplate">
                <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding ImageUrl}" Width="92" Height="104" Stretch="UniformToFill" IsTapEnabled="True" Tapped="PhotoImage_Tapped" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{Binding User}" Foreground="{ThemeResource SecondaryTextBrush}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Content="Save" Click="SavePhoto_Click" Margin="0,0,6,0" />
                                <Button Content="Download" Click="DownloadButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="SavedPhotoCardTemplate">
                <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding ImageUrl}" Width="92" Height="104" Stretch="UniformToFill" IsTapEnabled="True" Tapped="PhotoImage_Tapped" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{Binding User}" Foreground="{ThemeResource SecondaryTextBrush}" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Content="Remove" Click="RemoveSavedPhoto_Click" Margin="0,0,6,0" />
                                <Button Content="Download" Click="DownloadButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="PageRoot" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{ThemeResource HeaderBrush}" Padding="14" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="ROYALTURD  /  UNSPLASH" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                <TextBlock Text="UnsplashUWP" FontSize="30" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="StatusText" Text="Ready to connect" Foreground="{ThemeResource HeaderStatusBrush}" FontSize="12" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Pivot x:Name="LibraryPivot" Grid.Row="1" Margin="0,6,0,0">
            <PivotItem Header="Discover">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="Search photos" VerticalAlignment="Center" />
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LoginButton" Content="Sign in" Margin="0,0,4,0" />
                        <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Margin="4,0,0,0" />
                    </Grid>
                    <ListView x:Name="PhotoList" Grid.Row="2" Margin="0,10,0,0" ItemTemplate="{StaticResource PhotoCardTemplate}" />
                </Grid>
            </PivotItem>
            <PivotItem Header="Recent">
                <ListView x:Name="RecentPhotoList" Margin="0,8,0,0" ItemTemplate="{StaticResource PhotoCardTemplate}" />
            </PivotItem>
            <PivotItem Header="Saved">
                <ListView x:Name="SavedPhotoList" Margin="0,8,0,0" ItemTemplate="{StaticResource SavedPhotoCardTemplate}" />
            </PivotItem>
            <PivotItem Header="Settings">
                <ScrollViewer>
                    <StackPanel Padding="0,8,0,16">
                        <TextBlock Text="API credentials" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="Access key" Foreground="{ThemeResource LabelTextBrush}" Margin="0,0,0,3" />
                        <TextBox x:Name="ClientIdBox" PlaceholderText="Paste your Unsplash access key" />
                        <TextBlock Text="Secret key" Foreground="{ThemeResource LabelTextBrush}" Margin="0,10,0,3" />
                        <PasswordBox x:Name="ClientSecretBox" PlaceholderText="Paste your Unsplash secret" />
                        <TextBlock Text="Redirect URI" Foreground="{ThemeResource LabelTextBrush}" Margin="0,10,0,3" />
                        <TextBox x:Name="RedirectUriBox" PlaceholderText="https://localhost/unsplash" />
                        <ToggleSwitch x:Name="DarkThemeToggle" Header="Dark theme" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SaveButton" Content="Save keys" Margin="0,0,4,0" />
                            <Button x:Name="TestButton" Grid.Column="1" Content="Test API" Margin="4,0" />
                            <Button x:Name="ClearButton" Grid.Column="2" Content="Clear" Margin="4,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
