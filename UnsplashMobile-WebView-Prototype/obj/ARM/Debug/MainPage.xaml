<Page
    x:Class="UnsplashMobile.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="UNSPLASH API" FontSize="26" FontWeight="Bold" />
            <TextBlock x:ConnectionId='13' x:Name="StatusText" Text="Ready to connect" Foreground="#BDBDBD" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Access Key" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:ConnectionId='11' x:Name="ClientIdBox" Grid.Row="1" PlaceholderText="Your Unsplash Access Key" />

            <TextBlock Grid.Row="2" Text="Secret Key" FontWeight="SemiBold" Margin="0,12,0,4" />
            <TextBox x:ConnectionId='12' x:Name="ClientSecretBox" Grid.Row="3" PlaceholderText="Your Unsplash Secret" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='7' x:Name="RedirectUriBox" PlaceholderText="Redirect URI" VerticalAlignment="Center" />
            <Button x:ConnectionId='8' x:Name="SaveButton" Grid.Column="1" Content="Save" Margin="8,0,0,0" />
            <Button x:ConnectionId='9' x:Name="TestButton" Grid.Column="2" Content="Test" Margin="8,0,0,0" />
            <Button x:ConnectionId='10' x:Name="ClearButton" Grid.Column="3" Content="Clear" Margin="8,0,0,0" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='4' x:Name="SearchBox" PlaceholderText="Search Unsplash photos" VerticalAlignment="Center" />
            <Button x:ConnectionId='5' x:Name="LoginButton" Grid.Column="1" Content="Login" Margin="8,0,0,0" />
            <Button x:ConnectionId='6' x:Name="SearchButton" Grid.Column="2" Content="Search" Margin="8,0,0,0" />
        </Grid>

        <ListView x:ConnectionId='2' x:Name="PhotoList" Grid.Row="4" Margin="0,12,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding ImageUrl}" Width="120" Height="120" Stretch="UniformToFill" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                            <TextBlock Text="{Binding User}" Foreground="#BDBDBD" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

